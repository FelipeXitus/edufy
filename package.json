{
  "name": "edufy",
  "version": "0.0.1",
  "description": "Repositório de exemplo do curso de Monolitos Modulares com NestJS da Alura",
  "author": "Thiago R. V. Martins",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24.9.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:repl": "npm run start -- --watch --watchAssets --entryFile repl",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "dotenvx run -f .env.test -- node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "dotenvx run -f .env.test -- node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:cov": "dotenvx run -f .env.test -- node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:int": "dotenvx run -f .env.test -- node --experimental-vm-modules node_modules/jest/bin/jest.js --config ./test/jest-int.json --runInBand",
    "test:e2e": "dotenvx run -f .env.test -- node --experimental-vm-modules node_modules/jest/bin/jest.js --config ./test/jest-e2e.json --runInBand",
    "prepare": "husky || true",
    "kysely": "dotenvx run -- kysely",
    "migrate": "npm run kysely -- migrate:latest",
    "postmigrate": "npm run codegen",
    "codegen": "kysely-codegen --camel-case --out-file ./src/libs/database/generated/db.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.3",
    "@nestjs/config": "^12.1.0",
    "@nestjs/core": "^12.3.3",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/mapped-types": "12.0.1",
    "@nestjs/platform-express": "^12.3.3",
    "argon2": "^0.45.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "kysely": "^0.29.8",
    "pg": "8.23.1",
    "pg-boss": "^12.38.1",
    "postgres-interval": "^4.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "2.38.2",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.12",
    "@nestjs/testing": "12.3.3",
    "@types/express": "5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "jest": "^30.5.2",
    "kysely-codegen": "^0.20.0",
    "kysely-ctl": "0.22.0",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "source-map-support": "0.5.21",
    "supertest": "7.3.1",
    "ts-jest": "^29.4.15",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "^6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "extensionsToTreatAsEsm": [
  ".ts"
  ],
  "transform": {
    "^.+\\.tsx?$": [
      "ts-jest",
        {
          "useESM": true,
          "tsconfig": "<rootDir>/../tsconfig.spec.json"
        }
    ]
},
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@src/(.*)$": "<rootDir>/$1",
      "^@test/(.*)$": "<rootDir>/../test/$1",
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "nest build",
      "node --experimental-vm-modules node_modules/jest/bin/jest.js --bail --findRelatedTests --passWithNoTests"
    ]
  },
  "allowScripts": {
    "@nestjs/core@11.1.6": true,
    "@parcel/watcher@2.6.0": true,
    "argon2@0.45.2": true
  }
}
