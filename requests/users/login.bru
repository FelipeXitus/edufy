meta {
  name: login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/users/login
  body: json
  auth: inherit
}

body:json {
  {
    "email": "felipe@test.com",
    "password": "password123"
  }
}

vars:post-response {
  token: res.body.jwtAccessToken
}

settings {
  encodeUrl: true
  timeout: 0
}
